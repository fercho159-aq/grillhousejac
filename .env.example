# Cadena de conexión de Neon (Vercel la crea sola si conectas Neon desde Storage).
# Si no está definida en desarrollo, se usa una base local en .data/
DATABASE_URL=

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Opcional: secreto para firmar la sesión (si no, se usa ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
